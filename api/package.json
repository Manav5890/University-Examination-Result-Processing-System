{
  "name": "university-exam-backend",
  "version": "1.0.0",
  "description": "University examination and result processing backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed:test-csvs": "node scripts/generate-all-test-csvs.mjs",
    "seed:10k": "node scripts/seed-10k-import.mjs",
    "seed:100k": "node scripts/seed-large-import.mjs 100000",
    "seed:1m": "node scripts/seed-large-import.mjs 1000000",
    "test": "jest --runInBand"
  },
  "keywords": [
    "university",
    "examination",
    "results",
    "backend",
    "node",
    "typescript"
  ],
  "author": "Samarth",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.34.0",
    "csv-parse": "^6.1.0",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
